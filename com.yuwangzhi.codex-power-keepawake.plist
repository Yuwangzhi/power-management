<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yuwangzhi.codex-power-keepawake</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/sbin/codex-power-keepawake.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/var/log/codex-power-keepawake.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/codex-power-keepawake.err</string>
</dict>
</plist>
